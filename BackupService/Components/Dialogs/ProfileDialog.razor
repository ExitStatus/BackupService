<div class="modal-overlay">
    <div class="modal create-profile" role="dialog" aria-modal="true" aria-label="@(IsEdit ? "Edit profile" : "Create profile")">
        <div class="profile-dialog-header">
            <h2>@DialogTitle</h2>
            <div class="profile-enabled-row">
                <span class="field-label">Enabled</span>
                <ProfileEnabledControl @bind-Value="Input.Enabled" />
            </div>
        </div>

        <p class="modal-intro">@IntroText</p>

        <CascadingValue Value="_browseMemory" IsFixed="true">
        <EditForm Model="Input" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <TabBar Items="_tabs" @bind-SelectedKey="_activeTab" />

            @* Both tab panels stay rendered (hidden via CSS when inactive) so the type editors' @@ref survive a
               Save from the Notifications tab. The wrapper is a fixed height (scrolls when needed) so switching
               tabs never changes the dialog's vertical size. *@
            <div class="profile-tab-content@(Input.Type == ProfileType.LightroomArchive ? " lightroom" : "")">
            <div style="@TabStyle("details")">

            @if (!IsEdit)
            {
                <label>
                    Profile type
                    <Dropdown TValue="ProfileType"
                              Value="Input.Type"
                              ValueChanged="OnTypeChanged"
                              Items="Enum.GetValues<ProfileType>()"
                              DisplayText="t => t.GetDescription()" />
                </label>
            }

            @* Two-column field grid: Name/Group, Source/Target connection, Schedule/Handle-missed. Placeholder
               <div>s keep a cell's column position when its field doesn't apply to the current profile type. *@
            <div class="profile-details-grid">

                @* Row 1: Name | Group *@
                <label>
                    Name
                    <InputText @ref="_nameInput" @bind-Value="Input.Name" />
                </label>

                @* The Group picker only appears once at least one group exists. A Sequential group serialises its
                   members' runs; a Parallel group leaves them to run concurrently. *@
                @if (_groups.Count > 0)
                {
                    <label>
                        Group
                        <Dropdown TValue="int?"
                                  @bind-Value="Input.GroupId"
                                  Items="_groupOptions"
                                  DisplayText="GroupLabel" />
                    </label>
                }
                else
                {
                    <div></div>
                }

                @* Row 2: Source connection | Target connection. The connection is profile-level (shared by every
                   row). Source only for the scheduled types — InstantSync/LightroomArchive are watcher-driven with
                   a local-only source, so that cell is left empty for them. *@
                @if (Input.Type is ProfileType.OneWaySync or ProfileType.ArchiveSync or ProfileType.TwoWaySync)
                {
                    <ConnectionLocationField Label="Source connection" ShowFolder="false" AllowMtp="@SourceAllowsMtp"
                                             @bind-ConnectionId="Input.SourceConnectionId" />
                }
                else
                {
                    @* Watcher-driven types (InstantSync/LightroomArchive) have a local-only source — a
                       FileSystemWatcher can't observe a remote connection. Show it fixed and disabled. *@
                    <label>
                        Source connection
                        <Dropdown TValue="int?" Value="(int?)null" Items="_localSourceOption"
                                  DisplayText="@(_ => "This machine (local)")" Disabled="true" />
                    </label>
                }

                @* OneWaySync/ArchiveSync may target a read/write USB mass-storage drive (but not a read-only MTP
                   camera); the watcher-driven types can't target USB at all. *@
                <ConnectionLocationField Label="Target connection" ShowFolder="false" AllowUsb="@TargetAllowsUsb" AllowMtp="false"
                                         @bind-ConnectionId="Input.TargetConnectionId" />

                @* Row 3: Schedule — only for scheduled (non-device-triggered, non-watcher) types.
                   The Handle-missed toggle lives in the dialog's action bar; device-triggered/watcher notes
                   render full-width below the grid instead. *@
                @if (ShowSchedule)
                {
                    <label>
                        Schedule
                        <div class="input-row">
                            <input type="text" readonly value="@ScheduleText" />
                            <button type="button" class="btn-secondary" @onclick="OpenSchedule">Set</button>
                        </div>
                    </label>
                }

            </div>

            @if (IsDeviceTriggered)
            {
                <p class="help-text">@DeviceTriggeredNote</p>

                @if (ShowEjectOption)
                {
                    <label class="check" title="Safely remove the USB drive(s) once the run finishes, so they can be unplugged.">
                        <input type="checkbox" @bind="Input.EjectAfterRun" />
                        Eject device(s) after automatic run
                    </label>
                }
            }

            @if (Input.Type == ProfileType.LightroomArchive)
            {
                <ConnectionLocationField Label="Lightroom folder" Grouped="true" LocalOnly="true" @bind-Path="Input.LightroomFolder"
                                         Error="@(_lightroomFolderError ? "The Lightroom folder field is required." : null)" />

                <label title="@RawFormatsTooltip">
                    Raw formats
                    <input type="text" @bind="Input.RawFormats" placeholder=".DNG,.ARW" title="@RawFormatsTooltip" />
                </label>

                <label title="@RawFolderNameTooltip">
                    RAW folder name
                    <input type="text" @bind="Input.RawFolderName" placeholder="RAW" title="@RawFolderNameTooltip" />
                </label>
            }

            </div>

            <div style="@TabStyle("actions")">

            @switch (Input.Type)
            {
                case ProfileType.OneWaySync:
                    <OneWaySyncControl @ref="_oneWaySyncControl" Items="_oneWaySyncItems"
                                       SourceConnectionId="Input.SourceConnectionId" TargetConnectionId="Input.TargetConnectionId" />
                    break;
                case ProfileType.InstantSync:
                    <InstantSyncControl @ref="_instantSyncControl" Items="_instantSyncItems"
                                        TargetConnectionId="Input.TargetConnectionId" />
                    break;
                case ProfileType.ArchiveSync:
                    <ArchiveSyncControl @ref="_archiveSyncControl" Items="_archiveSyncItems"
                                        SourceConnectionId="Input.SourceConnectionId" TargetConnectionId="Input.TargetConnectionId" />
                    break;
                case ProfileType.LightroomArchive:
                    <LightroomArchiveControl @ref="_lightroomArchiveControl" Items="_lightroomArchiveItems"
                                             TargetConnectionId="Input.TargetConnectionId" />
                    break;
                case ProfileType.TwoWaySync:
                    <TwoWaySyncControl @ref="_twoWaySyncControl" Items="_twoWaySyncItems"
                                       SourceConnectionId="Input.SourceConnectionId" TargetConnectionId="Input.TargetConnectionId" />
                    break;
            }

            </div>

            <div style="@TabStyle("notifications")">
                <label class="check">
                    <input type="checkbox" @bind="Input.NotificationsEnabled" />
                    Enable Notifications
                </label>
                <p class="help-text">
                    Show a desktop notification for this profile's runs. Also requires the global
                    <strong>Allow Notifications</strong> option (Settings → Options) to be on.
                </p>

                <div class="check-rows">
                    <label class="check@(Input.NotificationsEnabled ? "" : " check-disabled")">
                        <input type="checkbox" @bind="Input.NotifyOnStart" disabled="@(!Input.NotificationsEnabled)" />
                        @NotifyLabel("started")
                    </label>

                    <label class="check@(Input.NotificationsEnabled ? "" : " check-disabled")">
                        <input type="checkbox" @bind="Input.NotifyOnComplete" disabled="@(!Input.NotificationsEnabled)" />
                        @NotifyLabel("completed")
                    </label>

                    @* Only OneWaySync/ArchiveSync/TwoWaySync can eject a USB drive after an automatic run. *@
                    @if (Input.Type is ProfileType.OneWaySync or ProfileType.ArchiveSync or ProfileType.TwoWaySync)
                    {
                        <label class="check@(Input.NotificationsEnabled ? "" : " check-disabled")"
                               title="Show a notification when this profile ejects a USB drive after an automatic run.">
                            <input type="checkbox" @bind="Input.NotifyOnEject" disabled="@(!Input.NotificationsEnabled)" />
                            Notify on eject
                        </label>
                    }
                </div>

                <label class="check">
                    <input type="checkbox" @bind="Input.ShowProgressWindow" />
                    Show Progress Window
                </label>
                <p class="help-text">
                    While this profile runs, show a small borderless progress window in the bottom-right of the
                    screen. Multiple running profiles stack vertically. (Windows only.)
                </p>
            </div>
            </div>

            <ValidationSummary />

            @if (_folderError is not null)
            {
                <span class="validation-message">@_folderError</span>
            }

            <div class="modal-actions">
                @* Handle missed sync (scheduled types only) sits at the far left, vertically centred with the
                   action buttons — a toggle with its label on the right. *@
                @if (ShowSchedule)
                {
                    <label class="profile-missed-toggle" title="@HandleMissedSyncTooltip">
                        <ToggleButton @bind-Value="Input.HandleMissedSync" />
                        <span>Handle missed sync</span>
                    </label>
                }
                @* Delete (edit only) sits to the left of Cancel. margin-left:auto on Delete (or Cancel when
                   creating) pushes this whole group to the right. *@
                @if (IsEdit)
                {
                    <button type="button" class="btn-danger" style="margin-left:auto" @onclick="() => _showDeleteConfirm = true">Delete</button>
                    <button type="button" class="btn-secondary" @onclick="OnCancel">Cancel</button>
                }
                else
                {
                    <button type="button" class="btn-secondary" style="margin-left:auto" @onclick="OnCancel">Cancel</button>
                }
                <button type="submit" disabled="@_saving">@(IsEdit ? "Save" : "Create")</button>
            </div>
        </EditForm>
        </CascadingValue>
    </div>
</div>

@if (_showSchedule)
{
    <ScheduleDialog Initial="_schedule"
                    OnApply="OnScheduleApplied"
                    OnCancel="() => _showSchedule = false" />
}

@if (_showDeleteConfirm)
{
    <ConfirmDialog Title="Delete profile"
                   Message="@($"Delete the profile \"{Input.Name}\"? This cannot be undone.")"
                   ConfirmText="Delete"
                   OnConfirm="ConfirmDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />
}
