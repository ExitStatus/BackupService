<div class="modal-overlay">
    <div class="modal schedule-dialog" role="dialog" aria-modal="true" aria-label="Set schedule">
        <h2>Schedule</h2>

        <label>
            Frequency
            <Dropdown TValue="ScheduleMode"
                      @bind-Value="_def.Mode"
                      Items="Enum.GetValues<ScheduleMode>()"
                      DisplayText="ModeLabel" />
        </label>

        @switch (_def.Mode)
        {
            case ScheduleMode.EveryNMinutes:
                <label>
                    Run every
                    <Dropdown TValue="int"
                              @bind-Value="_def.IntervalMinutes"
                              Items="IntervalOptions"
                              DisplayText="IntervalLabel" />
                </label>
                break;

            case ScheduleMode.Hourly:
                <label>
                    At minute
                    <input type="number" min="0" max="59" @bind="_def.Minute" />
                </label>
                break;

            case ScheduleMode.Daily:
                <label>
                    At time
                    <TimePicker @bind-Value="ScheduleTime" />
                </label>
                break;

            case ScheduleMode.Weekly:
                <div class="field-label">On days</div>
                <div class="weekdays">
                    @foreach (var day in WeekDays)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@_def.DaysOfWeek.Contains(day)"
                                   @onchange="e => ToggleDay(day, (bool)e.Value!)" />
                            @day.ToString()[..3]
                        </label>
                    }
                </div>
                <label>
                    At time
                    <TimePicker @bind-Value="ScheduleTime" />
                </label>
                break;

            case ScheduleMode.Monthly:
                <label>
                    On day of month
                    <Dropdown TValue="int"
                              @bind-Value="MonthDay"
                              Items="MonthDays"
                              DisplayText="MonthDayLabel" />
                </label>
                @if (!_def.LastDayOfMonth && _def.DayOfMonth > 28)
                {
                    <div class="help-text">Months without a day @_def.DayOfMonth are skipped. Choose "Last day of the month" to run at the end of every month.</div>
                }
                <label>
                    At time
                    <TimePicker @bind-Value="ScheduleTime" />
                </label>
                break;
        }

        @if (_error is not null)
        {
            <span class="validation-message">@_error</span>
        }

        <div class="modal-actions">
            <button type="button" class="btn-secondary" @onclick="OnCancel">Cancel</button>
            <button type="button" @onclick="ApplyAsync">Apply</button>
        </div>
    </div>
</div>
