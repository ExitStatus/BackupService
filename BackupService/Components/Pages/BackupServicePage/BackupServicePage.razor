@page "/"
@rendermode InteractiveServer

<PageTitle>Backup Service</PageTitle>

<div class="workspace">
    <BackupServiceSidebar SelectedKey="@SelectedKey" SelectedKeyChanged="OnSectionChanged" />

    <div class="workspace-content">
        @switch (SelectedKey)
        {
            case "dashboard":
                <Dashboard />
                break;

            case "profiles":
                <Profiles OnOpenLog="OpenLog" />
                break;

            case "scheduledtasks":
                <ScheduledTasksControl />
                break;

            case "logs":
                <Logs FocusLogId="FocusLogId" />
                break;

            case "connections":
                <ConnectionsControl />
                break;

            case "groups":
                <GroupsControl />
                break;

            default:
                <h1>Backup Service</h1>
                <div class="card">
                    <p>Select a section from the sidebar.</p>
                </div>
                break;
        }
    </div>
</div>
