<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Backup Service</title>
    <link rel="icon" href="Icons/icon.ico" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Blazor-ApexCharts/js/blazor-apexcharts.js"></script>
    <script>
        // Stop Enter in an opted-out input (class "no-enter-submit") from implicitly
        // submitting the surrounding EditForm. Blazor Server can't preventDefault from
        // its server-side keydown handler (it round-trips after the browser has already
        // submitted), so guard on the client. This does not stop the keydown reaching
        // Blazor, so the component's own onkeydown handler still runs.
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && e.target instanceof HTMLInputElement
                && e.target.classList.contains('no-enter-submit')) {
                e.preventDefault();
            }
        });

        // Close any open themed Dropdown (.dropdown.open) when clicking outside it. The dropdown's close state
        // lives in Blazor, so we trigger it by clicking the toggle (which toggles it shut). Robust against
        // CSS stacking contexts that can defeat a click-backdrop. The outside element still gets its own click.
        document.addEventListener('pointerdown', function (e) {
            document.querySelectorAll('.dropdown.open').forEach(function (dd) {
                if (!dd.contains(e.target)) {
                    var toggle = dd.querySelector('.dropdown-toggle');
                    if (toggle) { toggle.click(); }
                }
            });
        }, true);

        // Scroll a log terminal (a scrollable .log-terminal container, by element id) to the bottom,
        // so newly-appended lines from a running backup stay in view. Called from Logs.razor.cs after a
        // refresh adds lines (unless the user paused scrolling for that log).
        window.scrollLogTerminalToBottom = function (id) {
            var el = document.getElementById(id);
            if (el) { el.scrollTop = el.scrollHeight; }
        };

        // Drag-resize the folder browser's sidebar (.fb-splitter sits between .fb-sidebar and
        // .fb-details inside .fb-body — see FolderBrowserDialog.razor). Delegated on document
        // since the dialog is added/removed from the DOM dynamically.
        (function () {
            var drag = null;

            document.addEventListener('pointerdown', function (e) {
                var splitter = e.target.closest && e.target.closest('.fb-splitter');
                if (!splitter) { return; }
                var body = splitter.closest('.fb-body');
                if (!body) { return; }
                drag = { splitter: splitter, body: body, startX: e.clientX, startWidth: splitter.previousElementSibling.getBoundingClientRect().width };
                splitter.classList.add('dragging');
                document.body.style.userSelect = 'none';
                e.preventDefault();
            });

            document.addEventListener('pointermove', function (e) {
                if (!drag) { return; }
                var width = Math.min(420, Math.max(140, drag.startWidth + (e.clientX - drag.startX)));
                drag.body.style.gridTemplateColumns = width + 'px 6px 1fr';
            });

            document.addEventListener('pointerup', function () {
                if (!drag) { return; }
                drag.splitter.classList.remove('dragging');
                document.body.style.userSelect = '';
                drag = null;
            });
        })();
    </script>
</body>

</html>
