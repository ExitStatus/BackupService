<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile (Linux).
  Produces a linux-x64 build of the app.

      dotnet publish -p:PublishProfile=InstallLinux

  (The profile name has no dot on purpose: the SDK strips a ".something" suffix as a file extension, so a name like
  "Install.Linux" would wrongly resolve to the Install profile.)

  The Linux artifact runs in the FOREGROUND only — the Windows -background/-stop process-control model is not
  available on Linux. Run it under a process manager instead (systemd/Docker); a sample unit is in
  deploy/backupservice.service. Stop it with Ctrl+C or "systemctl stop backupservice". With ASPNETCORE_ENVIRONMENT
  unset the app runs as Production (admin UI on http://localhost:55000); the data directory is ~/.local/share/BackupService.

  SelfContained=false means the target host must have the ASP.NET Core 10 runtime installed. To ship a fully
  self-contained single file instead (no runtime prerequisite), set SelfContained=true and PublishSingleFile=true.

  PublishDir is a repo-relative staging folder; point it at your real deploy location (e.g. /opt/backupservice)
  or copy the staged output there.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\publish\linux-x64\</PublishDir>
  </PropertyGroup>

  <!-- No pre-publish "stop the running instance" step: that runs "BackupService.exe -stop" (Windows-only). On Linux,
       stop the foreground/systemd process before redeploying. -->

  <!-- Bump the build number on every deploy, writing it to both the source file (for next time) and the deployed
       folder (so the running instance reports the new number). Pure MSBuild — cross-platform. -->
  <Target Name="IncrementBuildNumber" AfterTargets="Publish">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\buildnumber.txt" Condition="Exists('$(MSBuildProjectDirectory)\buildnumber.txt')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentBuild>@(_BuildNumberLines)</_CurrentBuild>
      <_CurrentBuild Condition="'$(_CurrentBuild)' == ''">0</_CurrentBuild>
      <_NextBuild>$([MSBuild]::Add($(_CurrentBuild), 1))</_NextBuild>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\buildnumber.txt" Lines="$(_NextBuild)" Overwrite="true" />
    <WriteLinesToFile File="$(PublishDir)buildnumber.txt" Lines="$(_NextBuild)" Overwrite="true" />
    <Message Importance="high" Text="=== Deployed build number: $(_NextBuild) ===" />
  </Target>
</Project>
