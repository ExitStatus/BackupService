<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user folder publish profile (Linux).
  Publishes a linux-x64 build straight to the standard per-user app-install location under XDG_DATA_HOME
  (~/.local/share) rather than a repo-relative staging folder (contrast InstallLinux.pubxml) — the per-user
  analogue of Install.pubxml's fixed C:\Tools\BackupService on Windows.

      dotnet publish -p:PublishProfile=InstallLinuxUser

  Published to $HOME/.local/share/BackupService/app/ — a subfolder of the app's own DATA directory
  (~/.local/share/BackupService/, see BackupDatabaseLocation.GetDataDirectory) so the program files sit
  alongside, without colliding with, the live database/logs/keys the running app writes directly under that
  folder.

  The Linux artifact runs in the FOREGROUND only — the Windows -background/-stop process-control model is not
  available on Linux (see BackgroundProcessManager). Start it via Settings → Options → "Start application when
  you log in" (an XDG autostart entry pointing at wherever it's currently running from — no extra step needed
  after a redeploy) or run it manually; stop it with Ctrl+C. With ASPNETCORE_ENVIRONMENT unset the app runs as
  Production (admin UI on http://localhost:55000).

  SelfContained=false means the target host must have the ASP.NET Core 10 runtime installed. To ship a fully
  self-contained single file instead (no runtime prerequisite), set SelfContained=true and PublishSingleFile=true.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>$(HOME)/.local/share/BackupService/app/</PublishDir>
  </PropertyGroup>

  <!-- No pre-publish "stop the running instance" step: that runs "BackupService.exe -stop" (Windows-only). On
       Linux, stop the running foreground process (however you launched it) before redeploying. -->

  <!-- Bake the published version (0.0.{next build}-published) into the assembly BEFORE it is compiled, so the
       running instance reports it via BuildInfo. This only reads buildnumber.txt (it does not write it), so it is
       safe to run more than once during a build — the number is persisted once, after publish, below.
       Forward slashes here (unlike InstallLinux.pubxml's backslashes) so the path resolves correctly on Unix. -->
  <Target Name="SetPublishedVersion" BeforeTargets="GetAssemblyVersion">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/buildnumber.txt" Condition="Exists('$(MSBuildProjectDirectory)/buildnumber.txt')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentBuild>@(_BuildNumberLines)</_CurrentBuild>
      <_CurrentBuild Condition="'$(_CurrentBuild)' == ''">0</_CurrentBuild>
      <_NextBuild>$([MSBuild]::Add($(_CurrentBuild), 1))</_NextBuild>
      <Version>0.0.$(_NextBuild)-published</Version>
      <InformationalVersion>0.0.$(_NextBuild)-published</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Persist the incremented build number to the source file (for next time), once, after a successful publish.
       Re-reads/-computes independently of the target above so it does not depend on a shared property. -->
  <Target Name="PersistPublishedBuildNumber" AfterTargets="Publish">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/buildnumber.txt" Condition="Exists('$(MSBuildProjectDirectory)/buildnumber.txt')">
      <Output TaskParameter="Lines" ItemName="_PersistBuildLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PersistCurrent>@(_PersistBuildLines)</_PersistCurrent>
      <_PersistCurrent Condition="'$(_PersistCurrent)' == ''">0</_PersistCurrent>
      <_PersistNext>$([MSBuild]::Add($(_PersistCurrent), 1))</_PersistNext>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/buildnumber.txt" Lines="$(_PersistNext)" Overwrite="true" />
    <Message Importance="high" Text="=== Published version: 0.0.$(_PersistNext)-published ===" />
  </Target>
</Project>
